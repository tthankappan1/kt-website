# Copy to .env.local (never committed). Set the same values in the Vercel dashboard.
#
# KT CRM ingestion (issue #6): both lead-capture forms forward server-side to
# the CRM. The bearer key is a server-only secret — never NEXT_PUBLIC_, never
# committed. The CRM has no CORS (deliberate); calls only work server-side.
KT_CRM_INGEST_API_KEY=
# Optional override; defaults to https://kt-crm.onrender.com/api/v1/contacts/ingest
KT_CRM_INGEST_URL=
#
# Optional v1: lead-notification email via Resend (not wired yet)
RESEND_API_KEY=
# Server-only preview flag — set to "true" ONLY on a non-production preview
# deploy to render draft blog posts. Ignored when NODE_ENV=production (drafts
# can never ship to production). Do NOT prefix with NEXT_PUBLIC_.
SHOW_DRAFTS=
